#!/bin/bash
# On boot: always start BABY_BOX_SETUP access point.
set -euo pipefail

AP_SSID="BABY_BOX_SETUP"
AP_IP="192.168.4.1"

logger -t babybox-boot-wifi "waiting for NetworkManager"
for _ in $(seq 1 30); do
  if systemctl is-active --quiet NetworkManager; then
    break
  fi
  sleep 1
done

logger -t babybox-boot-wifi "starting AP ${AP_SSID}"

# Drop any client Wi-Fi so the radio is free for AP.
nmcli radio wifi on || true
systemctl stop hostapd dnsmasq 2>/dev/null || true

# Disconnect saved client profiles on wlan0 (do not autoconnect on boot).
nmcli device disconnect wlan0 2>/dev/null || true
nmcli device set wlan0 managed no

ip link set wlan0 down || true
ip addr flush dev wlan0 || true
ip addr add "${AP_IP}/24" dev wlan0
ip link set wlan0 up

systemctl start hostapd
systemctl start dnsmasq

logger -t babybox-boot-wifi "AP is up at http://${AP_IP}:5000/wifi"
