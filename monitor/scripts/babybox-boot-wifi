#!/bin/bash
# On boot: always start BABY_BOX_SETUP access point.
# Keep this fast — OLED and the phone both wait on AP / first screen.
set -euo pipefail

AP_SSID="BABY_BOX_SETUP"
AP_IP="192.168.4.1"

# OLED: show Wi-Fi icon from the very start of boot (never fail the script).
rm -f /tmp/babybox-oled-ready || true

logger -t babybox-boot-wifi "waiting for NetworkManager"
# After=NetworkManager.service already ordered us; only a short readiness
# poll so nmcli works. Do not burn 30s here on Pi 3.
for _ in $(seq 1 10); do
  if systemctl is-active --quiet NetworkManager \
    && nmcli -t general status >/dev/null 2>&1; then
    break
  fi
  sleep 0.5
done

logger -t babybox-boot-wifi "starting AP ${AP_SSID}"

# Design: every boot raises setup AP. Disable client autoconnect so NM does
# not spend boot time joining a saved home Wi-Fi before we take the radio.
while IFS=: read -r name type; do
  case "${type}" in
    *wireless*|*wifi*|802-11-wireless)
      nmcli connection modify "$name" connection.autoconnect no 2>/dev/null || true
      ;;
  esac
done < <(nmcli -t -f NAME,TYPE connection show 2>/dev/null || true)

# Drop any client Wi-Fi so the radio is free for AP.
nmcli radio wifi on || true
systemctl stop hostapd dnsmasq 2>/dev/null || true

# Disconnect saved client profiles on wlan0 (do not autoconnect on boot).
nmcli device disconnect wlan0 2>/dev/null || true
nmcli device set wlan0 managed no

ip link set wlan0 down || true
ip addr flush dev wlan0 || true
ip addr add "${AP_IP}/24" dev wlan0
ip link set wlan0 up

# hostapd first → SSID appears ASAP; dnsmasq right after for DHCP.
systemctl start hostapd
systemctl start dnsmasq

logger -t babybox-boot-wifi "AP is up at http://${AP_IP}:5000/wifi"
