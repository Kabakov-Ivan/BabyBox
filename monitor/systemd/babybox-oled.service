[Unit]
Description=BabyBox OLED clock (SSD1306)
# Start as soon as the root FS is ready. Do NOT wait for multi-user /
# network: multi-user is blocked by babybox-boot-wifi (oneshot), and that
# was delaying the first OLED frame by a long time on Pi 3.
After=local-fs.target

[Service]
Type=simple
User=admin
Group=admin
SupplementaryGroups=gpio i2c
WorkingDirectory=/home/admin/BabyBox/monitor/app
Environment=PYTHONUNBUFFERED=1
Environment=OLED_SCL_BCM=23
Environment=OLED_SDA_BCM=22
Environment=OLED_I2C_ADDR=0x3C,0x3D
Environment=OLED_POLL_SEC=0.25
Environment=OLED_STATUS_FILE=/tmp/babybox-oled.json
Environment=OLED_READY_FLAG=/tmp/babybox-oled-ready
ExecStart=/home/admin/BabyBox/monitor/.venv/bin/python /home/admin/BabyBox/monitor/app/oled_clock.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
